# Include documentation files
include README.md
include LICENSE
include CLAUDE.md
include DEPLOYMENT_GUIDE.md
include docs/INPUT_LIMITS_ANALYSIS.md

# Include requirements files
include requirements.txt

# Include environment template
include .env.example

# Include templates and static files
recursive-include src/lecture_forge/templates *.html *.css *.js *.txt .env.example

# Exclude unnecessary files
global-exclude __pycache__
global-exclude *.py[cod]
global-exclude *.so
global-exclude .DS_Store
global-exclude *.bak

# Exclude test and development files from distribution
prune tests
prune .git
prune data
prune outputs
