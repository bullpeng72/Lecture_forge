# ===== OpenAI API (필수) =====
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===== 인터넷 검색 API (필수) =====
# Serper API (https://serper.dev/)
# 무료 티어: 2,500 검색/월
SERPER_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 검색 설정
SEARCH_NUM_RESULTS=10        # 검색 결과 수 (최대 100)
SEARCH_TIMEOUT=30            # 검색 타임아웃 (초)

# ===== 이미지 검색 API (선택) =====
# Unsplash (https://unsplash.com/developers)
# 무료: 50 요청/시간
UNSPLASH_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Pexels (https://www.pexels.com/api/)
# 무료: 무제한 (rate limit 있음)
PEXELS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 이미지 검색 설정
IMAGE_SEARCH_PER_PAGE=10     # API 호출당 이미지 수 (Unsplash 최대 30, Pexels 최대 80)
IMAGE_SEARCH_TIMEOUT=30      # API 타임아웃 (초)

# ===== LLM 설정 =====
# 기본 모델 (GPT-4o-mini)
DEFAULT_MODEL=gpt-4o-mini
TEMPERATURE=0.7

# Vision 모델 (이미지 분석용)
VISION_MODEL=gpt-4o

# 임베딩 모델
EMBEDDING_MODEL=text-embedding-3-small

# ===== Vector DB 설정 =====
VECTOR_DB_PATH=./data/vector_db
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ===== RAG 캐시 설정 =====
RAG_CACHE_PATH=./data/rag_cache  # 캐시 저장 경로
RAG_CACHE_TTL=86400              # 캐시 유효 시간 (초, 기본 24시간)
RAG_CACHE_MAX_SIZE=1000          # 최대 캐시 항목 수

# ===== 품질 설정 =====
QUALITY_THRESHOLD=80             # 전체 강의 품질 임계값 (0-100)
QUALITY_THRESHOLD_SECTION=70     # 섹션별 품질 임계값 (전체보다 낮음)
MAX_ITERATIONS=3                 # 최대 품질 개선 반복 횟수

# 다이어그램 품질 임계값 (0-100)
DIAGRAM_QUALITY_THRESHOLD=70

# ===== 컨텐츠 메트릭 설정 =====
# 강의 속도 (분당 단어 수)
# 일반 읽기: 200-250 wpm, 강의: 120 wpm (시연, 질문 시간 포함)
LECTURE_WORDS_PER_MINUTE=120

# 난이도별 단어 수 조정 배율
DIFFICULTY_MULTIPLIER_BEGINNER=1.3      # 초급: 자세한 설명 필요
DIFFICULTY_MULTIPLIER_INTERMEDIATE=1.0  # 중급: 표준
DIFFICULTY_MULTIPLIER_ADVANCED=1.1      # 고급: 밀도 높은 내용

# 코드 예제 빈도 (분/예제)
CODE_EXAMPLES_PER_TIME_BEGINNER=20      # 20분당 1개
CODE_EXAMPLES_PER_TIME_INTERMEDIATE=15  # 15분당 1개
CODE_EXAMPLES_PER_TIME_ADVANCED=12      # 12분당 1개

# 실습 문제 빈도 (분/문제)
PRACTICE_PER_TIME_BEGINNER=25           # 25분당 1개
PRACTICE_PER_TIME_INTERMEDIATE=20       # 20분당 1개
PRACTICE_PER_TIME_ADVANCED=30           # 30분당 1개 (더 복잡)

# 하위 섹션 및 시각 자료
SUBSECTION_MINUTES=12                   # 12분당 1개 하위 섹션
VISUAL_PER_MINUTES=10                   # 10분당 1개 시각 자료

# 단어 수 허용 범위
MIN_WORDS_RATIO=0.75                    # 목표의 75% 이상
MAX_WORDS_RATIO=1.3                     # 목표의 130% 이하

# ===== 슬라이드 생성 설정 =====
MAX_ITEMS_PER_SLIDE=4                   # 슬라이드당 최대 컨텐츠 블록 수

# ===== 이미지 설정 =====
# 검색 설정
MAX_IMAGES_PER_SEARCH=10
IMAGE_FORMAT=webp
IMAGE_MAX_WIDTH=1920             # 최대 이미지 너비 (Full HD 지원, 고해상도 권장)

# 추출 설정 (PDF/웹에서 이미지 추출 시)
# 최소 크기 (작은 아이콘/로고 제거)
# v0.2.5+: 200x200 → 500x300 (고품질 이미지 확보)
# v0.2.6: thumbnail 버그 수정으로 원본 크기 완전 보존
IMAGE_MIN_WIDTH=500
IMAGE_MIN_HEIGHT=300

# 품질 임계값 (0.0 ~ 1.0)
# 추출 단계: 의미있는 이미지만 추출 (다이어그램, 차트, 텍스트 포함 이미지 우선)
# 개선된 알고리즘: 크기(15%) + 종횡비(15%) + 압축률(20%) + 컨텐츠(30%) + 의미성(20%)
IMAGE_EXTRACTION_QUALITY_THRESHOLD=0.35
# 선택 단계: 강의에 포함할 이미지 선택 (더 엄격)
IMAGE_SELECTION_QUALITY_THRESHOLD=0.40

# ===== 웹 스크래핑 설정 =====
# 기본 웹 스크래퍼
WEB_SCRAPER_TIMEOUT=30       # 웹 페이지 로드 타임아웃 (초)

# Deep Web Crawler (BeautifulSoup 기반)
DEEP_CRAWLER_MAX_DEPTH=2     # 크롤링 깊이 (1=검색결과만, 2=링크된 페이지 포함)
DEEP_CRAWLER_MAX_PAGES=10    # 최대 크롤링 페이지 수
DEEP_CRAWLER_DELAY=1.0       # 요청 간 지연시간 (초, rate limiting)
DEEP_CRAWLER_TIMEOUT=30      # 페이지 로드 타임아웃 (초)
DEEP_CRAWLER_BASE_URL=https://news.hada.io  # 기본 크롤링 대상 URL

# Playwright Crawler (JavaScript 렌더링 지원)
PLAYWRIGHT_MAX_DEPTH=2       # 크롤링 깊이
PLAYWRIGHT_MAX_PAGES=10      # 최대 크롤링 페이지 수
PLAYWRIGHT_DELAY=2.0         # 요청 간 지연시간 (초, rate limiting용)
PLAYWRIGHT_TIMEOUT=30000     # 페이지 로드 타임아웃 (밀리초)
PLAYWRIGHT_WAIT_STATE=networkidle  # 대기 상태: networkidle (권장), domcontentloaded, load

# ===== 기타 설정 =====
OUTPUT_DIR=./outputs
LOG_LEVEL=INFO

# ChromaDB 설정
ANONYMIZED_TELEMETRY=False   # ChromaDB 텔레메트리 비활성화 (PostHog 에러 방지)
